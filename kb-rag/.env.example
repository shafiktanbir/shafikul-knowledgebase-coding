# Optional: only needed if NOT using Antigravity's built-in Gemini auth
# If GEMINI_API_KEY is not set, the SDK will use Application Default Credentials

# GEMINI_API_KEY=your_key_here

# For OpenAI provider (optional - not needed for default Gemini setup)
# OPENAI_API_KEY=your_key_here

# For Anthropic Claude LLM (optional)
# ANTHROPIC_API_KEY=your_key_here
